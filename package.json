{
  "name": "vue-lib-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "start": "vite",
    "prebuild": "rimraf -g *.tsbuildinfo dist temp",
    "build": "vite build && npm run build:dts && npm run build:api",
    "build:dts": "vue-tsc -b",
    "build:api": "node api-extractor.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.60.1",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/server-renderer": "3.5.45",
    "is-ci": "4.1.0",
    "rimraf": "6.1.4",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vue-tsc": "3.3.14"
  }
}
